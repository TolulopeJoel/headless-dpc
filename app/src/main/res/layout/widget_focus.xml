<?xml version="1.0" encoding="utf-8"?>
<!-- Tolu's focus widget: a 1×1 tile, the ring on the part of the day's colours. FocusWidget draws both. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/focus_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/focus_sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/focus_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="4dp"
        android:scaleType="fitCenter" />
</FrameLayout>
