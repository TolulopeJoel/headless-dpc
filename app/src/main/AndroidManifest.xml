<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:testOnly="true"
        android:label="Tolu's DPC"
        android:allowBackup="false">

        <!-- Device Owner receiver — no launcher intent filter = invisible -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Schedule receiver: handles alarms, boot, time changes and app updates -->
        <receiver
            android:name=".ScheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.tolu.dpc.ACTION_ENTRY_SAVED" />
                <action android:name="com.tolu.dpc.ACTION_GRACE" />
                <action android:name="com.tolu.dpc.ACTION_PREVIEW" />
                <action android:name="com.tolu.dpc.ACTION_TEST_NIGHT" />
                <action android:name="com.tolu.dpc.ACTION_TEST_MORNING" />
                <action android:name="com.tolu.dpc.ACTION_TEST_END" />
                <action android:name="com.tolu.dpc.ACTION_TEST_GATE" />
            </intent-filter>
        </receiver>

        <!-- Keeps the process alive so HiOS doesn't freeze it and drop its alarms -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Device-owner focus schedule: suspends apps in the evening and at night" />
        </service>

        <!-- Home-screen widget: a placed widget exempts the app from HiOS freezing -->
        <receiver
            android:name=".FocusWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_widget_info" />
        </receiver>

        <!-- Setup activity — no launcher intent filter = invisible to drawer -->
        <activity
            android:name=".SetupActivity"
            android:exported="true" />

        <activity
            android:name=".RemoveActivity"
            android:exported="true" />

        <!-- Replaces Android's "Blocked by work policy" dialog with BlockedActivity (enabled once over adb) -->
        <service
            android:name=".BlockScreenService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/block_screen_service" />
        </service>

        <activity
            android:name=".BlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

    </application>
</manifest>
