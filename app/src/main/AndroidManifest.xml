<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Assignments: an "Assignment" event in the calendar keeps the hotspot until 22:00 the night before -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Happened: the day as it happened, written to his "Happened" calendar -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- ModeWallpaper: his wallpaper, tinted for the part of the day -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- The field pass: time away from home, from a geofence round home (only the leaving and returning times are kept) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Connecting to the phone's own debugging service on 127.0.0.1, to read Field Service's backup -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Closing Chrome when its rules change, so it reads them (a running Chrome keeps the old ones) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Colour dims and greys the screen through two display settings; granted once with adb pm grant. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application
        android:testOnly="true"
        android:label="Tolu's DPC"
        android:allowBackup="false">

        <!-- Device Owner receiver — no launcher intent filter = invisible -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Schedule receiver: handles alarms, boot, time changes and app updates -->
        <receiver
            android:name=".ScheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.tolu.dpc.ACTION_ENTRY_SAVED" />
                <action android:name="com.tolu.dpc.ACTION_EXPORT_HAPPENED" />
                <action android:name="com.tolu.dpc.ACTION_PREVIEW" />
                <action android:name="com.tolu.dpc.ACTION_TEST_COLOUR" />
                <action android:name="com.tolu.dpc.ACTION_TEST_TIDE" />
                <action android:name="com.tolu.dpc.ACTION_TEST_NIGHT" />
                <action android:name="com.tolu.dpc.ACTION_TEST_MORNING" />
                <action android:name="com.tolu.dpc.ACTION_TEST_END" />
                <action android:name="com.tolu.dpc.ACTION_TEST_GATE" />
            </intent-filter>
        </receiver>

        <!-- Keeps the process alive so HiOS doesn't freeze it and drop its alarms -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Device-owner focus schedule: suspends apps in the evening and at night" />
        </service>

        <!-- Home-screen widget: a placed widget exempts the app from HiOS freezing -->
        <receiver
            android:name=".FocusWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_widget_info" />
        </receiver>

        <!-- The bar: one 4×1 widget that shows what matters now (replaces the ring) -->
        <receiver
            android:name=".NowBar"
            android:label="Now"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_bar_info" />
        </receiver>

        <!-- Setup activity — no launcher intent filter = invisible to drawer -->
        <activity
            android:name=".SetupActivity"
            android:exported="true" />

        <activity
            android:name=".RemoveActivity"
            android:exported="true" />

        <!-- Replaces Android's "Blocked by work policy" dialog with BlockedActivity (enabled once over adb) -->
        <service
            android:name=".BlockScreenService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/block_screen_service" />
        </service>

        <activity
            android:name=".BlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Today's reading check, in the open: status, what Àṣàrò sent, every attempt -->
        <activity
            android:name=".ReadingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- Behind the ring widget: what's going on now -->
        <activity
            android:name=".NowActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- Shows only the wallpaper, so adb can photograph it -->
        <activity
            android:name=".WallpaperPeekActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Wallpaper.NoTitleBar.Fullscreen" />

        <!-- Google's location service reports leaving and coming home here -->
        <receiver
            android:name=".Away$Receiver"
            android:exported="false" />

        <!-- The home survey: precise readings while he walks the house -->
        <receiver
            android:name=".Away$Survey"
            android:exported="false" />

        <!-- A location note every 5 minutes (the in/out alerts get dropped; these get through) -->
        <receiver
            android:name=".Away$Pulse"
            android:exported="false" />

        <!-- Location notes while he's out (Trail), from Google's location service -->
        <receiver
            android:name=".Trail$Receiver"
            android:exported="false" />

        <!-- Study and meeting prep: running, stopping, adding one he forgot -->
        <activity
            android:name=".SessionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- "Where were you?" after a trip the plan and known places couldn't label -->
        <activity
            android:name=".WhereActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- His people from Field Service: who's near, their notes -->
        <activity
            android:name=".PeopleActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- The 20:01 review -->
        <activity
            android:name=".ReviewActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- Field Service's backups, shared to the DPC: Backup → "E-mail etc." → "Read my visits" -->
        <activity
            android:name=".ReceiveBackupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="Read my visits"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The field pass: opened from the blocked screen and the widget during a field session -->
        <activity
            android:name=".FieldPassActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

    </application>
</manifest>
